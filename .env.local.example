# Copiar este archivo a .env.local (ya está en .gitignore — nunca se sube)
# y completar los valores reales ahí. Sin estas variables el formulario de
# contacto sigue funcionando (ver components/ContactForm.tsx) pero avisa
# que el envío no está configurado.

# Resend (https://resend.com) — API key con permiso de envío.
RESEND_API_KEY=

# Remitente verificado en Resend. Mientras no se verifique un dominio
# propio, Resend solo permite enviar desde onboarding@resend.dev y solo
# al email de la cuenta — suficiente para probar, no para producción.
RESEND_FROM_EMAIL=onboarding@resend.dev

# A quién llegan las consultas del formulario. Si se deja vacío, usa
# CONTACT_EMAIL de lib/site-config.ts.
CONTACT_TO_EMAIL=

# reCAPTCHA v3 (https://www.google.com/recaptcha/admin) — crear un sitio
# tipo "v3", agregar el dominio de producción (y localhost para probar).
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
